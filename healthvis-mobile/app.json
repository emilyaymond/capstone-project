{
  "expo": {
    "name": "healthvis-mobile",
    "slug": "healthvis-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "healthvismobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.healthvis-mobile",
      "infoPlist": {
        "NSHealthShareUsageDescription": "HealthVis reads your health data (heart rate, steps, sleep, and more) so it can present it as accessible charts, audio, and haptics."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.healthvismobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "react-native-health",
        {
          "healthSharePermission": "HealthVis reads your health data (heart rate, steps, sleep, and more) so it can present it as accessible charts, audio, and haptics.",
          "healthUpdatePermission": "HealthVis does not write health data."
        }
      ],
      "expo-asset",
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": false,
          "androidForegroundService": false,
          "androidPermissions": [],
          "disableFFmpeg": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
